# /etc/james/james.env on the VPS (chmod 600, owner root). Used to render
# postgres.properties with envsubst; see the comment at its top.
# Values for Railway Postgres: Railway dashboard > Postgres > Settings >
# Networking > TCP Proxy.
JAMES_DB_HOST=xxx.proxy.rlwy.net
JAMES_DB_PORT=12345
JAMES_DB_PASSWORD=
